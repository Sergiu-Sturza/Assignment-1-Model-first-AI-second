%% The website sends "SET,20.0,30.0"; the device applies it and confirms.
%% Source of diagrams/input/sequence-change_threshold.drawio.
sequenceDiagram
    actor Loop
    participant CommandHandler
    participant SerialLink
    participant CommandParser
    participant Threshold
    participant MessageFormatter
    Loop->>CommandHandler: poll()
    CommandHandler->>SerialLink: readLine()
    SerialLink-->>CommandHandler: "SET,20.0,30.0"
    CommandHandler->>CommandParser: parse(line)
    CommandParser-->>CommandHandler: command
    CommandHandler->>Threshold: set(low, high)
    Threshold-->>CommandHandler: true
    CommandHandler->>MessageFormatter: formatThreshold(threshold)
    MessageFormatter->>Threshold: getLow()
    MessageFormatter->>Threshold: getHigh()
    MessageFormatter-->>CommandHandler: "TH,20.0,30.0"
    CommandHandler->>SerialLink: writeLine(text)
