{
    // Ctrl+Shift+B (Cmd+Shift+B on macOS) runs "Verify design": it asks which
    // project to verify (project/ or an example), empties its diagrams/output/,
    // and regenerates it and reports/ from diagrams/input/*.drawio and impl/.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Verify design",
            "detail": "Pick a project; regenerate its diagrams/output/ and reports/",
            "type": "process",
            "command": "python3",
            "windows": {
                "command": "python"
            },
            "args": ["${workspaceFolder}/tools/verify.py"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            },
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
        },
        {
            "label": "Set up Python environment",
            "detail": "Create .venv with the libclang bindings (does nothing if it already works)",
            "type": "shell",
            "command": ".venv/bin/python -c 'import clang.cindex' 2>/dev/null || { python3 -m venv .venv && .venv/bin/pip install --quiet -r requirements.txt; }",
            "windows": {
                "command": "if (Test-Path .venv\\Scripts\\python.exe) { .\\.venv\\Scripts\\python.exe -c 'import clang.cindex'; if ($LASTEXITCODE -eq 0) { exit 0 } }; python -m venv .venv; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt"
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "dedicated" }
        },
        {
            "label": "Arduino: generate diagrams from the model",
            "detail": "arduino/model/*.mmd -> arduino/diagrams/input/*.drawio",
            "type": "shell",
            "command": ".venv/bin/python -X utf8 arduino/tools/generate_diagrams.py",
            "windows": { "command": ".\\.venv\\Scripts\\python.exe -X utf8 arduino/tools/generate_diagrams.py" },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Arduino: measure the Figure of Merit",
            "detail": "Verify, test, benchmark and build the firmware; add one iteration to arduino/fom/",
            "type": "shell",
            "command": ".venv/bin/python -X utf8 arduino/tools/fom.py \"${input:iterationNote}\"",
            "windows": { "command": ".\\.venv\\Scripts\\python.exe -X utf8 arduino/tools/fom.py \"${input:iterationNote}\"" },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Arduino: serve the dashboard",
            "detail": "http://localhost:8000 (WebSerial needs localhost or HTTPS)",
            "type": "shell",
            "command": "python3 -m http.server 8000 --bind 127.0.0.1 -d arduino/dashboard",
            "windows": { "command": "python -m http.server 8000 --bind 127.0.0.1 -d arduino/dashboard" },
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "iterationNote",
            "type": "promptString",
            "description": "What changed in this iteration?"
        }
    ]
}
